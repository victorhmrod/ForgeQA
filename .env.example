# PostgreSQL
POSTGRES_DB=forgeqa
POSTGRES_USER=forgeqa
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend / JWT
# Generate a secret with: openssl rand -base64 64
JWT_SECRET=change-me-base64-secret
JWT_ISSUER=ForgeQA
JWT_AUDIENCE=ForgeQA
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

BACKEND_PORT=5000

# MinIO (S3-compatible object storage; not consumed by any feature in Milestone 0)
MINIO_ROOT_USER=forgeqa
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_ENDPOINT=http://minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000
FRONTEND_PORT=3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
